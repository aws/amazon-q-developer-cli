  "templating": {
    "list": [
      {
        "name": "client_application",
        "label": "Client / Engine",
        "description": "Filter by emitting engine: chat_cli (V1), chat_cli_v2 (V2), chat_cli_v3 (KAS/V3). Series without this label still appear under an empty value.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(client_application)",
        "query": {
          "qryType": 1,
          "query": "label_values(client_application)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance / Collector",
        "description": "Scope to a specific collector/process instance.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "service_name",
        "label": "Log service_name",
        "description": "Loki service_name to source logs from. V1 CLI emits as kiro-cli; V3/TUI emits as kiro-tui. Defaults to All so both are covered.",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values(service_name)",
        "query": {
          "qryType": 1,
          "query": "label_values(service_name)",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      }
    ]
  },

    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Raw sample of every kiro/chat/cli metric currently in Prometheus, filtered by the selected engine and instance. client_application and instance columns show who emitted each sample.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 8,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "exported_job": true,
              "otel_scope_name": false
            },
            "indexByName": {
              "__name__": 0,
              "client_application": 1,
              "instance": 2,
              "Value": 3
            },
            "renameByName": {}
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "{job=\"otel-collector\", client_application=~\"$client_application\", instance=~\"$instance\", __name__=~\"kiro_cli_.*\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "title": "All Kiro Metric Samples",
      "type": "table"
    },

  "templating": {
    "list": [
      {
        "name": "version_full",
        "label": "CLI Version",
        "description": "Filter slash-command usage by exact released or nightly CLI version.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(kiro_cli_slash_command_invoked_total, version_full)",
        "query": {
          "qryType": 1,
          "query": "label_values(kiro_cli_slash_command_invoked_total, version_full)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "agent_engine",
        "label": "Agent Engine",
        "description": "Filter by agent runtime: v1, v2, v3, or unknown.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(kiro_cli_run_started_total, agent_engine)",
        "query": {
          "qryType": 1,
          "query": "label_values(kiro_cli_run_started_total, agent_engine)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "slash_command",
        "label": "Slash Command",
        "description": "Filter by canonical first-party command or the bounded custom command buckets.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(kiro_cli_slash_command_invoked_total{version_full=~\"$version_full\", agent_engine=~\"$agent_engine\"}, slash_command)",
        "query": {
          "qryType": 1,
          "query": "label_values(kiro_cli_slash_command_invoked_total{version_full=~\"$version_full\", agent_engine=~\"$agent_engine\"}, slash_command)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance / Collector",
        "description": "Scope to a specific collector/process instance.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(instance)",
        "query": {
          "qryType": 1,
          "query": "label_values(instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0

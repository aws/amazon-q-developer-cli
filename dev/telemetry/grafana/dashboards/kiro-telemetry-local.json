          "expr": "sum by (client_application, agent_kind, exit_reason) (increase(kiro_cli_session_completed_total{job=\"otel-collector\", client_application=~\"$client_application\", instance=~\"$instance\"}[$__range])) or sum by (client_application, agent_kind, exit_reason) (increase(kiro_cli_session_completed_total_total{job=\"otel-collector\", client_application=~\"$client_application\", instance=~\"$instance\"}[$__range]))",
          "legendFormat": "{{client_application}} {{agent_kind}} {{exit_reason}}",
          "refId": "A",
          "instant": true
        }
      ],
      "title": "Session Completions By Agent",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "p95 time-to-first-token for Bedrock streams, split by engine (client_application).",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [],

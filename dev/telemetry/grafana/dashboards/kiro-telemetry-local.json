  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Count of CLI sessions started in the selected time range, split by client_application (V1/V2/V3). Uses increase() over the dashboard range so a single short dev session still shows a non-zero count.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client_application) (increase(cli_session_started_total{job=\"otel-collector\", client_application=~\"$client_application\", instance=~\"$instance\"}[$__range])) or sum by (client_application) (increase(cli_session_started_total_total{job=\"otel-collector\", client_application=~\"$client_application\", instance=~\"$instance\"}[$__range]))",
          "legendFormat": "{{client_application}}",
          "refId": "A"
        }
      ],
      "title": "CLI Sessions Started",
      "type": "stat"
    },

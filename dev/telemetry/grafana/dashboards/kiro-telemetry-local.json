        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (client_application, le) (rate(kiro_cli_bedrock_stream_ttft_bucket{job=\"otel-collector\", client_application=~\"$client_application\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{client_application}} p95",
          "refId": "A"
        }
      ],
      "title": "Bedrock TTFT p95",
      "type": "timeseries"
    },

#!/bin/sh
# Pre-commit hook for kiro-cli

# Block accidental commits of local dev checkouts
if git diff --cached --name-only | grep -q '^local/'; then
    echo "❌ Staged files under local/ — this directory is for local-only checkouts."
    echo "   Run: git reset local/"
    exit 1
fi

# Rust checks
if git diff --cached --name-only | grep -qE '\.(rs|toml)$'; then
    echo "Running cargo fmt check..."
    if ! cargo +nightly fmt --check -- --color always; then
        echo "❌ Formatting check failed. Run 'cargo +nightly fmt' to fix."
        exit 1
    fi

    echo "Running cargo clippy..."
    if ! cargo clippy --locked --workspace --color always -- -D warnings; then
        echo "❌ Clippy check failed. Fix the warnings above."
        exit 1
    fi
else
    echo "⏭️  No Rust files changed, skipping fmt and clippy"
fi

# TUI checks
if git diff --cached --name-only | grep -q '^packages/tui/'; then
    echo "Running bun lint..."
    if ! bun run --cwd packages/tui lint; then
        echo "❌ TUI lint failed. Run 'bun run lint:fix' in packages/tui to fix."
        exit 1
    fi
else
    echo "⏭️  No TUI files changed, skipping lint"
fi

# Changelog fragment checks — lint the staged bytes, not the working tree,
# so a partially staged fragment is judged by what the commit will contain.
# Scoped to staged files because the directory holds grandfathered entries
# that fail current rules.
STAGED_FRAGMENTS=$(git diff --cached --name-only --diff-filter=ACM | grep '^\.changes/.*\.json$' || true)
if [ -n "$STAGED_FRAGMENTS" ]; then
    echo "Linting staged changelog fragments..."
    FRAGMENT_TMPDIR=$(mktemp -d)
    trap 'rm -rf "$FRAGMENT_TMPDIR"' EXIT
    set --
    while IFS= read -r path; do
        [ -n "$path" ] || continue
        staged_copy="$FRAGMENT_TMPDIR/$(basename "$path")"
        git show ":$path" > "$staged_copy"
        set -- "$@" "$staged_copy"
    done <<EOF
$STAGED_FRAGMENTS
EOF
    if ! ./scripts/lint-changelog.sh "$@"; then
        echo "❌ Changelog lint failed on staged content. See .changes/GUIDELINES.md for format rules."
        exit 1
    fi
else
    echo "⏭️  No changelog fragments staged, skipping changelog lint"
fi

exit 0

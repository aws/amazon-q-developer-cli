{
  "name": "@kiro/tui",
  "version": "0.0.0-dev",
  "type": "module",
  "overrides": {
    "react": "19.2.3",
    "brace-expansion@^1": "1.1.13",
    "brace-expansion@^5": "5.0.6"
  },
  "scripts": {
    "preinstall": "bash ../../scripts/ensure-codeartifact-auth.sh",
    "dev": "bun run scripts/start-dev.ts",
    "dev:256": "COLORTERM= bun run scripts/start-dev.ts",
    "release": "bun run scripts/start-release.ts",
    "dev:storybook": "bun --watch src/storybook/run-storybook.tsx",
    "test:storybook:coverage": "bun --config=./bunfig.visual.toml test --timeout=30000 ./visual_tests/visual-coverage.test.ts ./visual_tests/terminal-frame.test.ts ./visual_tests/story-capture-contract.test.ts",
    "test:storybook:visual": "bun run src/storybook/capture-stories.ts",
    "build": "NODE_ENV=production bun build src/index.tsx --outfile dist/tui.js --target bun --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check src acp_integ_tests",
    "lint:fix": "eslint . --fix && prettier --write src acp_integ_tests",
    "format": "prettier --write src acp_integ_tests",
    "test": "bun test",
    "test:perf": "KIRO_PERF_TESTS=1 bun test src/components/layout/__tests__/SessionDashboardScreen.perf.test.tsx && KIRO_PERF_TESTS=1 bun test src/components/ui/__tests__/SessionDashboard.realstore-perf.test.tsx && bun test src/utils/__tests__/session-dashboard-perf.test.ts",
    "test:vitest": "vitest run --config vitest.config.ts",
    "test:watch": "bun test --watch",
    "test:integ": "bun test ./integ_tests/",
    "test:acp-integ": "bun test ./acp_integ_tests/ --reporter=junit --reporter-outfile=integ_tests/test-outputs/acp-integration-junit.xml",
    "report:acp-integ-coverage": "bun run scripts/report-capability-coverage.ts acp_integ_tests/coverage-manifest.json integ_tests/test-outputs/coverage integ_tests/test-outputs/acp-integration-junit.xml",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "bench:markdown": "bun run scripts/benchmark-markdown.ts",
    "dev:profile": "bun run scripts/start-dev-profile.ts",
    "analyze:profile": "bun run scripts/analyze-profile.ts --html",
    "knight-rider": "bun run e2e_tests/knight-rider.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.19.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.217.0",
    "@kiro/acp-type-covenant": "0.49.5",
    "@kiro/client": "0.49.5",
    "@types/diff": "^8.0.0",
    "ansi-escapes": "^7.3.0",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "diff": "^8.0.3",
    "ignore": "^7.0.5",
    "marked": "^18.0.2",
    "meow": "^13.2.0",
    "react": "^19.2.4",
    "react-reconciler": "~0.33.0",
    "supports-color": "^9.4.0",
    "twinki": "workspace:*",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@smithy/eventstream-codec": "4.4.2",
    "@types/bun": "^1.3.11",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^3.2.1",
    "@xterm/headless": "^6.0.0",
    "bun-pty": "^0.4.8",
    "es-toolkit": "^1.46.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "4.2.0",
    "js-yaml": "4.3.1",
    "react-devtools-core": "^7.0.1",
    "strip-ansi": "^7.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^3.2.1",
    "@kiro/agent": "0.49.5"
  },
  "module": "src/index.tsx",
  "private": true
}

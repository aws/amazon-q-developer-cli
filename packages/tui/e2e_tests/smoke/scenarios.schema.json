{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scenarios.schema.json",
  "title": "Knight Rider Smoke Test Scenarios",
  "description": "Schema for TUI smoke test scenarios driven by Knight Rider",
  "type": "object",
  "required": [
    "version",
    "scenarios"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Self-reference to this schema file"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver version of the scenarios format"
    },
    "generatedFrom": {
      "type": "string",
      "format": "uri",
      "description": "Documentation URL this scenario set was generated from"
    },
    "notes": {
      "type": "string",
      "description": "Human-readable notes about this scenario file"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "List of smoke test scenarios",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "description",
        "steps",
        "verify",
        "priority"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Unique kebab-case identifier for the scenario"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable scenario name"
        },
        "category": {
          "type": "string",
          "enum": [
            "boot",
            "panels",
            "agents",
            "model-config",
            "conversation",
            "rendering",
            "keyboard",
            "permissions",
            "tool-use",
            "subagents",
            "session-management",
            "cloud",
            "workflows",
            "context-management",
            "settings",
            "accessibility",
            "mcp",
            "model-sanity"
          ],
          "description": "Grouping category for the scenario"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "What this scenario tests"
        },
        "docRef": {
          "type": "string",
          "description": "URL path to relevant documentation"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "description": "Ordered execution steps",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "verify": {
          "type": "array",
          "minItems": 1,
          "description": "Machine-checkable assertions run after steps complete",
          "items": {
            "$ref": "#/$defs/verifyPredicate"
          }
        },
        "observe": {
          "type": "string",
          "description": "Free-form checklist for LLM or human visual review"
        },
        "acpMock": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional ACP mock backend configuration for deterministic scenario execution.",
          "properties": {
            "fixture": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "acp-wire"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "kas": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ext": {
                  "type": "object",
                  "additionalProperties": true
                },
                "session": {
                  "type": "object",
                  "additionalProperties": true
                },
                "local": {
                  "type": "object",
                  "additionalProperties": true
                },
                "upstream": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            },
            "v2": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "engine": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "v2",
              "kas"
            ]
          },
          "uniqueItems": true,
          "default": [
            "v2",
            "kas"
          ],
          "description": "Which agent engines this scenario runs on"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1000,
          "default": 30000,
          "description": "Per-scenario timeout in milliseconds"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Freeform tags for filtering scenarios"
        },
        "priority": {
          "type": "string",
          "enum": [
            "p0",
            "p1",
            "p2"
          ],
          "description": "Priority level for CI gating (p0 = must pass)"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra environment variables for the spawned TUI (e.g. rollout gates for dark-shipped commands)"
        },
        "terminal": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 20
            },
            "height": {
              "type": "integer",
              "minimum": 10
            }
          },
          "required": ["width", "height"],
          "additionalProperties": false,
          "description": "Terminal size for this scenario, overriding the lane default of 120x40. Layout-dependent assertions need it: a markdown table renders as a bordered grid or as stacked rows purely as a function of width"
        },
        "turns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "krs-turns.schema.json#/$defs/Turn"
          },
          "description": "Scripted KRS turns, in queue order, that answer this scenario's prompts when it runs against the fake Kiro Runtime Service. A scenario without them cannot run on the krs-mock backend."
        }
      }
    },
    "step": {
      "type": "string",
      "description": "A test step in the format 'action' or 'action:argument'",
      "pattern": "^(type|waitForText|prompt|sleep|frame):.+$|^(enter|waitForIdle|ctrlc|ctrlc-twice|ctrlj|ctrls|arrowUp|arrowDown|escape|tab)$"
    },
    "verifyPredicate": {
      "type": "string",
      "description": "An assertion in the format 'namespace.predicate:argument' or bare predicate",
      "pattern": "^(screen\\.(contains|notContains)|process\\.exited):.+$|^(process\\.exited|store\\.sessionId\\.changed)$"
    }
  }
}

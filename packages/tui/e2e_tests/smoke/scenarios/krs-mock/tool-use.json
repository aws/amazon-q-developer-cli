        "screen.notContains:Prompt already in progress",
        "screen.notContains:Standing by"
      ],
      "observe": "Each tool call renders as its own card (Read, Grep, Glob, Read for list_directory) in sequence, then the agent produces one synthesized answer after the whole chain returns.",
      "engine": [
        "kas"
      ],
      "tags": [
        "scenario",
        "journey"
      ],
      "turns": [
        {
          "name": "t1-read",
          "match": {
            "userInputContains": "investigate the project files"
          },
          "respond": {
            "events": [
              {
                "type": "toolUse",
                "toolUseId": "m1",
                "name": "read_file",
                "input": "{\"path\":\"package.json\"}",
                "stop": true
              },
              {
                "type": "metadata",
                "stopReason": "TOOL_USE"
              }
            ]
          }
        },
        {

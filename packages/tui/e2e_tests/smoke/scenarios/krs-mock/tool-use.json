    {
      "id": "tool-error-recovery",
      "name": "Shell command fails and the agent recovers",
      "category": "tool-use",
      "description": "User runs a command that exits non-zero; the shell tool surfaces the non-zero exit code and the agent reports the failure and recovers without corrupting the session",
      "docRef": "/docs/cli/chat/permissions",
      "priority": "p1",
      "steps": [
        "prompt:run the flaky probe",
        "waitForText:requires approval",
        "enter",
        "waitForIdle",
        "frame:after-error"
      ],
      "verify": [
        "screen.contains:Exit Code: 7",
        "screen.contains:exited with a non-zero status",
        "screen.notContains:The probe succeeded",
        "screen.notContains:Prompt already in progress"
      ],
      "observe": "The shell tool runs the failing command; its non-zero exit code renders in the shell card and the agent reports the failure and stays usable.",
      "engine": [
        "kas"
      ],
      "tags": [
        "scenario",
        "journey"
      ],
      "turns": [
        {
          "name": "ask-failing-command",
          "match": {
            "userInputContains": "run the flaky probe"
          },
          "respond": {
            "events": [
              {
                "type": "toolUse",
                "toolUseId": "tu-1",
                "name": "execute_bash",
                "input": "{\"command\":\"exit 7\"}",
                "stop": true
              },
              {
                "type": "metadata",
                "stopReason": "TOOL_USE"
              }
            ]
          }
        },
        {
          "name": "synthesize-after-error",
          "match": {
            "hasToolResults": true
          },
          "respond": {
            "events": [
              {
                "type": "text",
                "content": "The command exited with a non-zero status, so the probe did not succeed."
              },
              {
                "type": "metadata",
                "stopReason": "END_TURN"
              }
            ]
          }
        },
        {
          "name": "background-catch-all",
          "times": 0,
          "respond": {
            "events": [
              {
                "type": "text",
                "content": "The probe succeeded."
              },
              {
                "type": "metadata",
                "stopReason": "END_TURN"
              }
            ]
          }
        }
      ]
    },

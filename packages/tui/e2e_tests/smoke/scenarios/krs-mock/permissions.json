        "screen.contains:Rejected",
        "screen.contains:Mixed batch processed",
        "screen.notContains:requires approval",
        "screen.notContains:Prompt already in progress"
      ],
      "observe": "Two queued shell approvals; approving the first runs MIX-KEEP while denying the second drives MIX-DROP to a terminal Rejected state, and the agent synthesizes once both are resolved.",
      "engine": [
        "kas"
      ],
      "tags": [
        "scenario",
        "journey"
      ],
      "turns": [

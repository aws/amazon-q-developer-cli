                "type": "toolUse",
                "toolUseId": "b2",
                "name": "execute_bash",
                "input": "{\"command\":\"echo BATCH-TWO\"}",
                "stop": true
              },
              {
                "type": "toolUse",
                "toolUseId": "b3",
                "name": "execute_bash",
                "input": "{\"command\":\"echo BATCH-THREE\"}",

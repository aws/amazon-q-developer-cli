        },
        {
          "name": "catch-all",
          "times": 0,
          "respond": {
            "events": [
              {
                "type": "text",
                "content": "Standing by."
              },
              {
                "type": "metadata",
                "stopReason": "END_TURN"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "permissions-cascade-isolation",
      "name": "Trusting one tool does not cascade to another tool",
      "category": "permissions",
      "description": "User trusts the entire shell tool for the session; a later fs_write still requires its own approval - proving tool-scoped trust does not leak across tools",
      "docRef": "/docs/cli/chat/permissions",
      "priority": "p1",
      "steps": [
        "prompt:run the shell probe",
        "waitForText:requires approval",
        "arrowDown",
        "enter",
        "arrowDown",
        "arrowDown",
        "enter",
        "waitForIdle",
        "prompt:save the results file",
        "waitForText:kiro-cascade-iso",
        "frame:after-isolation"
      ],
      "verify": [
        "screen.contains:CASCADE-SHELL",
        "screen.contains:kiro-cascade-iso",
        "screen.contains:requires approval",
        "screen.notContains:Prompt already in progress"
      ],
      "engine": [
        "kas"
      ],
      "tags": [
        "scenario",
        "journey"
      ],
      "observe": "Trust entire tool is selected on the shell gate and the shell command runs. A later fs_write in the same session still raises its own approval gate, showing trust is scoped to the shell tool only.",
      "turns": [
        {
          "name": "shell-probe",
          "match": {
            "userInputContains": "run the shell probe"
          },
          "respond": {
            "events": [
              {
                "type": "toolUse",
                "toolUseId": "s1",
                "name": "execute_bash",
                "input": "{\"command\":\"echo CASCADE-SHELL\"}",
                "stop": true
              },
              {
                "type": "metadata",
                "stopReason": "TOOL_USE"
              }
            ]
          }
        },
        {
          "name": "after-shell",
          "match": {
            "hasToolResults": true
          },
          "respond": {
            "events": [
              {
                "type": "text",
                "content": "Shell probe handled."
              },
              {
                "type": "metadata",
                "stopReason": "END_TURN"
              }
            ]
          }
        },
        {
          "name": "write-file",
          "match": {
            "userInputContains": "save the results file"
          },
          "respond": {
            "events": [
              {
                "type": "toolUse",
                "toolUseId": "w1",
                "name": "fs_write",
                "input": "{\"path\":\"~/kiro-cascade-iso.txt\",\"text\":\"cascade wrote this\"}",
                "stop": true
              },
              {
                "type": "metadata",
                "stopReason": "TOOL_USE"
              }
            ]
          }
        },
        {
          "name": "catch-all",
          "times": 0,
          "respond": {
            "events": [
              {
                "type": "text",
                "content": "Standing by."
              },
              {
                "type": "metadata",
                "stopReason": "END_TURN"
              }
            ]
          }
        }
      ]
    },

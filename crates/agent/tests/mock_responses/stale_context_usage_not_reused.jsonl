// Regression fixture for the stale-reading resurrection bug.
//
// The shape that matters: the post-compaction retry reports NO contextUsagePercentage
// (usage is null). A reader that searches turn history backwards for the most recent
// reported value skips that turn, finds response 1's 100.0, and compacts again on the
// third prompt. Correct behavior is exactly one compaction across all three prompts.

// 1: first prompt reports 100%, at the vended limit
{"result":"ok","data":{"kind":"messageStart","data":{"role":"assistant"}}}
{"result":"ok","data":{"kind":"contentBlockDelta","data":{"delta":{"kind":"text","data":"I can help with that."},"contentBlockIndex":null}}}
{"result":"ok","data":{"kind":"messageStop","data":{"stopReason":"endTurn"}}}
{"result":"ok","data":{"kind":"metadata","data":{"metrics":{"requestStartTime":"2025-10-23T21:04:30.000000Z","requestEndTime":"2025-10-23T21:04:31.000000Z","timeToFirstChunk":{"secs":0,"nanos":100000000},"timeBetweenChunks":[],"responseStreamLen":20},"usage":{"inputTokens":1000,"outputTokens":100,"contextUsagePercentage":100.0},"service":{"requestId":"first-response","statusCode":null}}}}

// 2: compaction summary, triggered by the synthesized overflow on the second prompt
{"result":"ok","data":{"kind":"messageStart","data":{"role":"assistant"}}}
{"result":"ok","data":{"kind":"contentBlockDelta","data":{"delta":{"kind":"text","data":"# Conversation Summary\n\nThe user asked for help."},"contentBlockIndex":null}}}
{"result":"ok","data":{"kind":"messageStop","data":{"stopReason":"endTurn"}}}
{"result":"ok","data":{"kind":"metadata","data":{"metrics":{"requestStartTime":"2025-10-23T21:05:00.000000Z","requestEndTime":"2025-10-23T21:05:01.000000Z","timeToFirstChunk":{"secs":0,"nanos":100000000},"timeBetweenChunks":[],"responseStreamLen":50},"usage":null,"service":{"requestId":"compaction-summary","statusCode":null}}}}

// 3: post-compaction retry. usage is null, so this turn reports NO percentage.
{"result":"ok","data":{"kind":"messageStart","data":{"role":"assistant"}}}
{"result":"ok","data":{"kind":"contentBlockDelta","data":{"delta":{"kind":"text","data":"Answer to the second prompt."},"contentBlockIndex":null}}}
{"result":"ok","data":{"kind":"messageStop","data":{"stopReason":"endTurn"}}}
{"result":"ok","data":{"kind":"metadata","data":{"metrics":{"requestStartTime":"2025-10-23T21:06:00.000000Z","requestEndTime":"2025-10-23T21:06:01.000000Z","timeToFirstChunk":{"secs":0,"nanos":100000000},"timeBetweenChunks":[],"responseStreamLen":40},"usage":null,"service":{"requestId":"retry-no-usage","statusCode":null}}}}

// 4: third prompt. Consumed only if it dispatches normally instead of compacting again.
{"result":"ok","data":{"kind":"messageStart","data":{"role":"assistant"}}}
{"result":"ok","data":{"kind":"contentBlockDelta","data":{"delta":{"kind":"text","data":"Answer to the third prompt."},"contentBlockIndex":null}}}
{"result":"ok","data":{"kind":"messageStop","data":{"stopReason":"endTurn"}}}
{"result":"ok","data":{"kind":"metadata","data":{"metrics":{"requestStartTime":"2025-10-23T21:07:00.000000Z","requestEndTime":"2025-10-23T21:07:01.000000Z","timeToFirstChunk":{"secs":0,"nanos":100000000},"timeBetweenChunks":[],"responseStreamLen":40},"usage":null,"service":{"requestId":"third-prompt","statusCode":null}}}}

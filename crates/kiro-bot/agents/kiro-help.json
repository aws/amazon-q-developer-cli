{
  "name": "kiro-help",
  "description": "Help agent for the kiro-help Slack bot. Distinct from the in-CLI kiro_guide built-in: tools list and prompt are tuned for Slack DMs and channel mentions, not terminal sessions.",
  "prompt": "file://kiro_help_prompt.md",
  "mcpServers": {
    "kiro-knowledge": {
      "command": "kiro-knowledge-mcp",
      "args": [],
      "env": {}
    },
    "kiro-github-read": {
      "command": "kiro-github-mcp",
      "args": ["--scope", "read"],
      "env": {}
    },
    "kiro-github-write": {
      "command": "kiro-github-mcp",
      "args": ["--scope", "write"],
      "env": {}
    },
    "kiro-mcp": {
      "command": "kiro-mcp",
      "args": ["--enabled-families", "taskei"],
      "env": {
        "AWS_REGION": "us-east-1",
        "TASKEI_ENDPOINT": "https://iad.prod.service.mcp.taskei.amazon.dev/mcp",
        "TASKEI_ALLOW_ROOMS": "7c221a81-7ca7-436c-8f05-a7278949341b,4ac982ae-1285-44e0-af12-8d3662da5935"
      }
    }
  },
  "tools": [
    "introspect",
    "read",
    "execute_bash",
    "@kiro-knowledge/search_kiro_knowledge",
    "@kiro-github-read/search_github_issues",
    "@kiro-github-write/create_github_issue",
    "@kiro-github-write/comment_on_existing",
    "@kiro-mcp/Taskei___list_tasks",
    "@kiro-mcp/Taskei___get_task",
    "@kiro-mcp/Taskei___get_room",
    "@kiro-mcp/Taskei___list_room_resource"
  ],
  "allowedTools": [
    "@kiro-knowledge/search_kiro_knowledge",
    "@kiro-github-read/search_github_issues",
    "@kiro-mcp/Taskei___list_tasks",
    "@kiro-mcp/Taskei___get_task",
    "@kiro-mcp/Taskei___get_room",
    "@kiro-mcp/Taskei___list_room_resource",
    "introspect",
    "read"
  ],
  "toolsSettings": {
    "shell": {
      "denyByDefault": true,
      "allowedCommands": [
        "git log( .*)?",
        "git blame( .*)?",
        "git show( .*)?",
        "git diff( .*)?",
        "git status( .*)?",
        "git rev-parse( .*)?",
        "git branch( .*)?",
        "git tag( .*)?",
        "git ls-files( .*)?",
        "rg( .*)?",
        "find( .*)?",
        "wc( .*)?",
        "ls( .*)?",
        "stat( .*)?",
        "file( .*)?",
        "head( .*)?",
        "tail( .*)?",
        "cat( .*)?"
      ],
      "deniedCommands": [
        ".*--force.*",
        ".*\\bsudo\\b.*",
        ".*\\bcurl\\b.*",
        ".*\\bwget\\b.*",
        ".*\\bgit (push|pull|fetch|commit|reset|checkout|clean|rebase|merge|cherry-pick|stash)( .*)?",
        ".*\\b(rm|mv|cp|mkdir|rmdir|chmod|chown|tee|kill|killall|pkill)\\b.*",
        ".*\\b(npm|bun|yarn|pnpm|cargo)\\s+install\\b.*",
        ".*\\b(bash|sh|zsh)\\s+-c\\b.*",
        ".*\\beval\\b.*",
        ".*\\bsource\\b.*"
      ]
    }
  },
  "resources": [
    "skill://~/.kiro/agents/SKILL.md"
  ],
  "includeMcpJson": false,
  "welcomeMessage": "Ask me anything about Kiro CLI."
}

{
  "name": "kiro-help",
  "description": "Help agent for the kiro-help Slack bot. Distinct from the in-CLI kiro_guide built-in: tools list and prompt are tuned for Slack DMs and channel mentions, not terminal sessions.",
  "mcpServers": {
    "kiro-knowledge": {
      "command": "kiro-knowledge-mcp",
      "args": [],
      "env": {}
    },
    "kiro-github-read": {
      "command": "kiro-github-mcp",
      "args": ["--scope", "read"],
      "env": {}
    },
    "kiro-github-write": {
      "command": "kiro-github-mcp",
      "args": ["--scope", "write"],
      "env": {}
    }
  },
  "tools": [
    "introspect",
    "read",
    "@kiro-knowledge/search_kiro_knowledge",
    "@kiro-github-read/search_github_issues",
    "@kiro-github-write/create_github_issue",
    "@kiro-github-write/comment_on_existing"
  ],
  "allowedTools": [
    "@kiro-knowledge/search_kiro_knowledge",
    "@kiro-github-read/search_github_issues",
    "introspect"
  ],
  "resources": [
    "skill://~/.kiro/agents/SKILL.md"
  ],
  "includeMcpJson": false,
  "welcomeMessage": "Ask me anything about Kiro CLI."
}

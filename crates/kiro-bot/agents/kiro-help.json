{
  "name": "kiro-help",
  "description": "Help agent for the kiro-help Slack bot. Distinct from the in-CLI kiro_guide built-in: tools list and prompt are tuned for Slack DMs and channel mentions, not terminal sessions.",
  "prompt": "file://kiro_help_prompt.md",
  "mcpServers": {
    "kiro-github-read": {
      "command": "kiro-github-mcp",
      "args": ["--scope", "read"],
      "env": {
        "SLACK_BOT_TOKEN": "",
        "SLACK_APP_TOKEN": "",
        "KIRO_API_KEY": "",
        "KIRO_BOT_DISPATCH_TOKEN": ""
      }
    },
    "kiro-github-write": {
      "command": "kiro-github-mcp",
      "args": ["--scope", "write"],
      "env": {
        "SLACK_BOT_TOKEN": "",
        "SLACK_APP_TOKEN": "",
        "KIRO_API_KEY": "",
        "KIRO_BOT_DISPATCH_TOKEN": ""
      }
    },
    "kiro-mcp": {
      "command": "kiro-mcp",
      "args": ["--enabled-families", "taskei"],
      "env": {
        "SLACK_BOT_TOKEN": "",
        "SLACK_APP_TOKEN": "",
        "GH_PAT": "",
        "KIRO_API_KEY": "",
        "KIRO_BOT_DISPATCH_TOKEN": "",
        "AWS_REGION": "us-east-1",
        "TASKEI_ENDPOINT": "https://iad.prod.service.mcp.taskei.amazon.dev/mcp",
        "TASKEI_ALLOW_ROOMS": "7c221a81-7ca7-436c-8f05-a7278949341b,4ac982ae-1285-44e0-af12-8d3662da5935"
      }
    }
  },
  "tools": [
    "introspect",
    "read",
    "@kiro-github-read/search_github_issues",
    "@kiro-github-write/create_github_issue",
    "@kiro-github-write/comment_on_existing",
    "@kiro-mcp/Taskei___list_tasks",
    "@kiro-mcp/Taskei___get_task",
    "@kiro-mcp/Taskei___get_room",
    "@kiro-mcp/Taskei___list_room_resource"
  ],
  "allowedTools": [
    "@kiro-mcp/Taskei___list_tasks",
    "@kiro-mcp/Taskei___get_task",
    "@kiro-mcp/Taskei___get_room",
    "@kiro-mcp/Taskei___list_room_resource",
    "introspect"
  ],
  "toolsSettings": {
    "read": {
      "allowedPaths": [
        "./**"
      ],
      "deniedPaths": [
        "$KIRO_HOME/bots",
        "~/.aws",
        "~/.ssh",
        "~/.netrc",
        "~/.git-credentials",
        "/proc",
        "/sys",
        "/**/.env*",
        "/**/secrets.toml"
      ]
    }
  },
  "resources": [
    "skill://$KIRO_HOME/agents/SKILL.md"
  ],
  "includeMcpJson": false,
  "welcomeMessage": "Ask me anything about Kiro CLI. I use generative AI — answers may be incorrect or incomplete, so verify before acting on them."
}

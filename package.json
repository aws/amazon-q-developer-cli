{
  "name": "root",
  "private": true,
  "author": "Amazon Web Services",
  "repository": "https://github.com/aws/amazon-q-developer-cli",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@10.0.0+sha256.43abf6e720fb7bc53c591b0862605c7d323d0a9d2dd33bcac07b062e13cf4948",
  "type": "module",
  "engines": {
    "node": "^22.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "b": "turbo build",
    "test": "vitest",
    "test:ci": "vitest run --run --coverage",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "turbo lint --parallel",
    "lint:fix": "turbo lint:fix --parallel",
    "dev": "turbo dev",
    "dev:autocomplete": "pnpm -C packages/autocomplete dev",
    "dev:dashboard": "pnpm -C packages/dashboard dev",
    "preview:autocomplete": "pnpm -C packages/autocomplete preview",
    "preview:dashboard": "pnpm -C packages/dashboard preview",
    "clean": "turbo clean --parallel",
    "prepare": "husky",
    "precommit": "lint-staged --config .lintstagedrc.mjs"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.4",
      "tar-fs": ">=2.1.4",
      "jws": ">=4.0.1",
      "rollup": ">=4.59.0",
      "vite": ">=6.4.2",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "glob@>=11.0.0 <11.1.0": "11.1.0",
      "flatted": ">=3.4.2",
      "undici": ">=6.24.0",
      "lodash": ">=4.18.0",
      "picomatch@<2.3.2": "2.3.2",
      "serialize-javascript@<7.0.3": "7.0.3",
      "underscore": ">=1.13.8",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "tmp": ">=0.2.6"
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "micromatch": "^4.0.8",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "vitest": "^4.1.8"
  }
}

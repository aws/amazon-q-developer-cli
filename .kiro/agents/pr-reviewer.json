{
  "name": "pr-reviewer",
  "description": "Automated PR reviewer for CI. Delegates behavioral review to the semantic-reviewer sub-agent, handles memory queries, dedup, and Slack posting.",
  "prompt": "file://resources/REVIEWER_PROMPT.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "code",
    "grep",
    "glob",
    "knowledge",
    "subagent"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "execute_bash"
  ],
  "toolsSettings": {
    "execute_bash": {
      "autoAllowReadonly": true,
      "allowedCommands": [
        "^aws lambda invoke .*$",
        "^aws sts assume-role .*$",
        "^gh .*$",
        "^git .*$",
        "^cat[^&;|]*$",
        "^ls[^&;|]*$",
        "^head[^&;|]*$",
        "^tail[^&;|]*$",
        "^grep[^&;|]*$",
        "^find[^&;|]*$",
        "^jq[^&;|]*$",
        "^wc[^&;|]*$",
        "^curl[^&;|]*$"
      ]
    },
    "subagent": {
      "trustedAgents": [
        "semantic-reviewer"
      ],
      "availableAgents": [
        "semantic-reviewer"
      ]
    }
  },
  "resources": [
    "file://.kiro/skills/pr-memory/SKILL.md",
    "file://.kiro/skills/slack-publish/SKILL.md",
    "file://AGENTS.md"
  ],
  "hooks": {},
  "useLegacyMcpJson": true
}

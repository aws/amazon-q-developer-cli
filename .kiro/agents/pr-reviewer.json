{
  "name": "pr-reviewer",
  "description": "Automated PR reviewer for CI. Delegates behavioral review to the semantic-reviewer sub-agent, handles memory queries, dedup, and Slack posting.",
  "prompt": "file://resources/REVIEWER_PROMPT.md",
  "tools": [
    "code",
    "glob",
    "grep",
    "knowledge",
    "read",
    "shell",
    "subagent/semantic-reviewer",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "execute_bash"
  ],
  "toolsSettings": {
    "execute_bash": {
      "autoAllowReadonly": true,
      "allowedCommands": [
        "^aws lambda invoke .*$",
        "^aws sts assume-role .*$",
        "^gh .*$",
        "^git .*$",
        "^cat[^&;|]*$",
        "^ls[^&;|]*$",
        "^head[^&;|]*$",
        "^tail[^&;|]*$",
        "^grep[^&;|]*$",
        "^find[^&;|]*$",
        "^jq[^&;|]*$",
        "^wc[^&;|]*$",
        "^curl[^&;|]*$"
      ]
    },
    "subagent": {
      "trustedAgents": [
        "semantic-reviewer"
      ],
      "availableAgents": [
        "semantic-reviewer"
      ]
    }
  },
  "resources": [
    "file://.kiro/skills/pr-memory/SKILL.md",
    "file://.kiro/skills/slack-publish/SKILL.md",
    "file://AGENTS.md"
  ],
  "hooks": [],
  "useLegacyMcpJson": true,
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "aws lambda invoke *",
          "aws sts assume-role *",
          "gh *",
          "git *",
          "cat*",
          "ls*",
          "head*",
          "tail*",
          "grep*",
          "find*",
          "jq*",
          "wc*",
          "curl*"
        ],
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "match": [
          "semantic-reviewer"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  },
  "model": "claude-opus-5"
}

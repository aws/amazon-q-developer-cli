  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "execute_bash"
  ],
  "toolsSettings": {
    "execute_bash": {
      "autoAllowReadonly": true,
      "allowedCommands": [
        "^aws lambda invoke .*$",
        "^aws sts assume-role .*$",
        "^gh .*$",
        "^git .*$",
        "^cat[^&;|]*$",
        "^ls[^&;|]*$",
        "^head[^&;|]*$",
        "^tail[^&;|]*$",
        "^grep[^&;|]*$",
        "^find[^&;|]*$",
        "^jq[^&;|]*$",
        "^wc[^&;|]*$",
        "^curl[^&;|]*$"
      ]
    }
  },
  "resources": [
    "file://.kiro/skills/semantic-pr-reviewer/SKILL.md",

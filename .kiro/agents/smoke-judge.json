      "autoAllowReadonly" : true,
      "allowedCommands" : [ "^cat[^&;|]*$", "^ls[^&;|]*$", "^find[^&;|]*$", "^head[^&;|]*$", "^tail[^&;|]*$", "^grep[^&;|]*$", "^wc[^&;|]*$", "^jq[^&;|]*$" ]
    }
  }
}

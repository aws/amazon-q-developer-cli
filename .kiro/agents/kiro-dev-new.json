{
  "name": "kiro-dev-new",
  "description": "Kiro CLI development agent",
  "model": "claude-opus-4.6-1m",
  "prompt": "file://resources/KIRO_DEV_PROMPT.md",
  "tools": [
    "@builder-mcp/InternalSearch",
    "@builder-mcp/ReadInternalWebsites",
    "@ht-mcp",
    "code",
    "glob",
    "grep",
    "introspect",
    "knowledge",
    "read",
    "shell",
    "subagent/kiro-research-agent",
    "subagent/kiro_default",
    "subagent/wf-workflow-creator",
    "todo_list",
    "validate_workflow",
    "web",
    "web_fetch",
    "web_search",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "introspect",
    "knowledge",
    "@ht-mcp"
  ],
  "useLegacyMcpJson": true,
  "keyboardShortcut": "ctrl+1",
  "welcomeMessage": "Hi! I'm the Kiro-Dev agent for CLI development.\n\nAvailable agents:\n- `oncall` - For Kiro CLI oncall activities\n\nAvailable workflows:\n- `@changelog` - Propose changelog entries for recent changes\n- `@docs` - Update autodocs for code changes",
  "toolsSettings": {
    "execute_bash": {
      "autoAllowReadonly": true,
      "allowedCommands": [
        "^git status$",
        "^git diff[^&;|]*$",
        "^git log[^&;|]*$",
        "^git add[^&;|]*$",
        "^git pull[^&;|]*$",
        "^git commit[^&;|]*$",
        "^git checkout[^&;|]*$",
        "^cargo clippy[^&;]*$",
        "^cargo \\+nightly fmt[^&;]*$",
        "^cargo build[^&;]*$",
        "^cargo test[^&;]*$",
        "^bun install$",
        "^bun test[^&;|]*$",
        "^bun run[^&;|]*$",
        "^\\./scripts/generate-types\\.sh$",
        "^jq[^&;|]*$",
        "^cat[^&;|]*$",
        "^ls[^&;|]*$",
        "^pwd$",
        "^wc[^&;|]*$",
        "^head[^&;|]*$",
        "^tail[^&;|]*$",
        "^grep[^&;|]*$",
        "^find[^&;|]*$",
        "^mkdir[^&;|]*$",
        "^gh pr view[^&;|]*$",
        "^gh pr list[^&;|]*$",
        "^gh pr diff[^&;|]*$",
        "^gh issue view[^&;|]*$"
      ]
    },
    "subagent": {
      "trustedAgents": [
        "kiro-research-agent"
      ],
      "availableAgents": [
        "kiro-research-agent",
        "kiro_default"
      ]
    }
  },
  "resources": [
    "skill://autodocs/README.md",
    "file://AGENTS.md",
    "file://README.md"
  ],
  "hooks": [
    {
      "name": "agentSpawn-0",
      "trigger": "agentSpawn",
      "action": {
        "type": "command",
        "command": "git status"
      },
      "timeout": 10
    },
    {
      "name": "agentSpawn-1",
      "trigger": "agentSpawn",
      "action": {
        "type": "command",
        "command": "pwd"
      },
      "timeout": 10
    }
  ],
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "git status",
          "git diff*",
          "git log*",
          "git add*",
          "git pull*",
          "git commit*",
          "git checkout*",
          "cargo clippy*",
          "cargo +nightly fmt*",
          "cargo build*",
          "cargo test*",
          "bun install",
          "bun test*",
          "bun run*",
          "./scripts/generate-types.sh",
          "jq*",
          "cat*",
          "ls*",
          "pwd",
          "wc*",
          "head*",
          "tail*",
          "grep*",
          "find*",
          "mkdir*",
          "gh pr view*",
          "gh pr list*",
          "gh pr diff*",
          "gh issue view*"
        ],
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "match": [
          "kiro-research-agent",
          "wf-workflow-creator"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "ht-mcp/*"
        ],
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  }
}

{
  "name": "oncall",
  "description": "Kiro CLI oncall agent for ticket investigation, debugging, and operational tasks",
  "model": "claude-opus-4.7",
  "prompt": "file://resources/ONCALL_PROMPT.md",
  "welcomeMessage": "Hi! I'm the Oncall agent. Here's what I can help with:\n\n**Prompts:**\n• `@pr-triage` — classify open PRs, check dependabot status, apply labels, get a prioritized action list\n• `@pr-report` — generate a full classified markdown report of all open PRs\n• `@triage` — review active Sev-2 tickets and recommend what to work on\n\n**Workflows:**\n• `@changelog` — propose changelog entries for recent changes\n• `@docs` — update autodocs for code changes\n• `@generate-oncall-report` — build the `[Kiro-CLI] Weekly Ops Review` for the most recent completed oncall week, write it to `.ops/weekly-reviews/`, and open a review PR (defaults dates automatically; say a date range to override, `no pr` to skip the PR, or `dry run` to preview)\n• `@apply-ops-review-comments` — after the ops meeting, fold reviewer PR comments back into the report and push a fixup\n\nScripts are in `scripts/` — see `scripts/classify_prs.py` for PR classification.",
  "tools": [
    "@builder-mcp/InternalCodeSearch",
    "@builder-mcp/InternalSearch",
    "@builder-mcp/OncallReadActions",
    "@builder-mcp/ReadInternalWebsites",
    "@builder-mcp/TicketingReadActions",
    "@builder-mcp/TicketingWriteActions",
    "@builder-mcp/sim_add_comment",
    "@builder-mcp/sim_get_issue",
    "@builder-mcp/sim_search_issues",
    "@builder-mcp/sim_update_issue",
    "@creds-agent",
    "code",
    "glob",
    "grep",
    "introspect",
    "knowledge",
    "read",
    "shell",
    "subagent/kiro-research-agent",
    "write"
  ],
  "allowedTools": [
    "read",
    "write",
    "shell",
    "grep",
    "glob",
    "code",
    "introspect",
    "knowledge",
    "@builder-mcp/TicketingReadActions",
    "@builder-mcp/TicketingWriteActions",
    "@builder-mcp/ReadInternalWebsites",
    "@builder-mcp/OncallReadActions",
    "@builder-mcp/InternalCodeSearch",
    "@builder-mcp/InternalSearch",
    "@builder-mcp/sim_add_comment",
    "@builder-mcp/sim_update_issue",
    "@builder-mcp/sim_get_issue",
    "@builder-mcp/sim_search_issues",
    "@creds-agent"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "^gh pr view[^&;|]*$",
        "^gh pr list[^&;|]*$",
        "^gh pr diff[^&;|]*$",
        "^gh pr checkout [0-9]+[^&;|]*$",
        "^gh pr create[^&;|]*$",
        "^gh pr comment[^&;|]*$",
        "^gh issue view[^&;|]*$",
        "^gh api repos/[^&;|]*$",
        "^git checkout -b ops/weekly-review-[^&;|]*$",
        "^git checkout ops/weekly-review-[^&;|]*$",
        "^git add \\.ops/weekly-reviews/[^&;|]*$",
        "^git commit -m [^&;|]*$",
        "^git push -u origin ops/weekly-review-[^&;|]*$",
        "^git push$",
        "^git status[^&;|]*$"
      ]
    },
    "subagent": {
      "trustedAgents": [
        "kiro-research-agent"
      ],
      "availableAgents": [
        "kiro-research-agent"
      ]
    }
  },
  "resources": [
    "skill://autodocs/README.md",
    "file://AGENTS.md",
    "file://README.md",
    "skill://docs/oncall/*.md",
    "skill://.kiro/skills/weekly-ops-review/SKILL.md"
  ],
  "mcpServers": {
    "builder-mcp": {
      "command": "builder-mcp"
    },
    "creds-agent": {
      "command": "aim",
      "args": [
        "mcp",
        "start-server",
        "local-creds-agent-mcp"
      ]
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "gh pr view*",
          "gh pr list*",
          "gh pr diff*",
          "gh pr checkout *",
          "gh pr create*",
          "gh pr comment*",
          "gh issue view*",
          "gh api repos/*",
          "git checkout -b ops/weekly-review-*",
          "git checkout ops/weekly-review-*",
          "git add .ops/weekly-reviews/*",
          "git commit -m *",
          "git push -u origin ops/weekly-review-*",
          "git push",
          "git status*"
        ],
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "match": [
          "kiro-research-agent"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "builder-mcp/InternalCodeSearch",
          "builder-mcp/InternalSearch",
          "builder-mcp/OncallReadActions",
          "builder-mcp/ReadInternalWebsites",
          "builder-mcp/TicketingReadActions",
          "builder-mcp/TicketingWriteActions",
          "builder-mcp/sim_add_comment",
          "builder-mcp/sim_get_issue",
          "builder-mcp/sim_search_issues",
          "builder-mcp/sim_update_issue",
          "creds-agent/*"
        ],
        "effect": "allow"
      }
    ]
  }
}

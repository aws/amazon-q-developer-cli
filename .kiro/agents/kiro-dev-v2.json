{
  "name": "kiro-dev-v2",
  "description": "Kiro CLI V2 development agent for TUI (TypeScript/React/Ink) and chat-cli-v2 (Rust/ACP)",
  "model": "claude-opus-4.6-1m",
  "prompt": "file://resources/KIRO_DEV_V2_PROMPT.md",
  "tools": [
    "@creds-agent",
    "code",
    "glob",
    "grep",
    "introspect",
    "knowledge",
    "read",
    "shell",
    "subagent/kiro-research-agent",
    "subagent/kiro_default",
    "subagent/wf-workflow-creator",
    "todo_list",
    "validate_workflow",
    "write"
  ],
  "allowedTools": [
    "fs_read",
    "grep",
    "glob",
    "introspect",
    "knowledge",
    "@creds-agent"
  ],
  "keyboardShortcut": "ctrl+3",
  "welcomeMessage": "Hi! I'm the Kiro-Dev-V2 agent for TUI and ACP backend development. What would you like to build?",
  "toolsSettings": {
    "execute_bash": {
      "autoAllowReadonly": true,
      "allowedCommands": [
        "^git status$",
        "^git diff[^&;|]*$",
        "^git log[^&;|]*$",
        "^git add[^&;|]*$",
        "^git commit[^&;|]*$",
        "^cargo clippy[^&;]*$",
        "^cargo \\+nightly fmt[^&;]*$",
        "^cargo build[^&;]*$",
        "^cargo test[^&;]*$",
        "^bun install$",
        "^bun test[^&;|]*$",
        "^bun run[^&;|]*$",
        "^\\./scripts/generate-types\\.sh$",
        "^cat[^&;|]*$",
        "^ls[^&;|]*$",
        "^pwd$",
        "^gh pr view[^&;|]*$",
        "^gh pr list[^&;|]*$",
        "^gh pr diff[^&;|]*$",
        "^gh issue view[^&;|]*$"
      ]
    },
    "subagent": {
      "trustedAgents": [
        "kiro-research-agent"
      ],
      "availableAgents": [
        "kiro-research-agent",
        "kiro_default"
      ]
    }
  },
  "resources": [
    "file://AGENTS.md",
    "file://README.md",
    "file://crates/chat-cli-v2/README.md",
    "file://packages/tui/TESTING.md",
    "skill://.kiro/skills/*/SKILL.md"
  ],
  "hooks": [
    {
      "name": "agentSpawn-0",
      "trigger": "agentSpawn",
      "action": {
        "type": "command",
        "command": "git status"
      },
      "timeout": 10
    },
    {
      "name": "agentSpawn-1",
      "trigger": "agentSpawn",
      "action": {
        "type": "command",
        "command": "pwd"
      },
      "timeout": 10
    }
  ],
  "mcpServers": {
    "creds-agent": {
      "command": "aim",
      "args": [
        "mcp",
        "start-server",
        "local-creds-agent-mcp"
      ]
    }
  },
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "git status",
          "git diff*",
          "git log*",
          "git add*",
          "git commit*",
          "cargo clippy*",
          "cargo +nightly fmt*",
          "cargo build*",
          "cargo test*",
          "bun install",
          "bun test*",
          "bun run*",
          "./scripts/generate-types.sh",
          "cat*",
          "ls*",
          "pwd",
          "gh pr view*",
          "gh pr list*",
          "gh pr diff*",
          "gh issue view*"
        ],
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "match": [
          "kiro-research-agent",
          "wf-workflow-creator"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "mcp",
        "match": [
          "creds-agent/*"
        ],
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  }
}
